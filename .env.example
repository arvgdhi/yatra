# Copy to backend/.env (backend settings) and frontend/.env.local (frontend settings).
# No secrets are required for the public archives used by this app. Never commit real values.

# ------------------------------------------------------------------ backend (prefix EXPLORER_)
# Product name shown in the API and reports (the UI reads NEXT_PUBLIC_APP_NAME below).
EXPLORER_APP_NAME="Yatra"

# Where the SQLite database, uploads and archive downloads are stored.
EXPLORER_DATA_DIR=./data

# Upload limit in MB, and how long uploaded files are kept before automatic deletion.
EXPLORER_MAX_UPLOAD_MB=50
EXPLORER_UPLOAD_TTL_HOURS=24

# Hard cap on rows parsed from a table.
EXPLORER_MAX_ROWS=3000000

# Number of analysis worker processes (each runs one analysis at a time).
EXPLORER_MAX_WORKERS=2

# Disable all archive network access (the API then reports that it is offline).
EXPLORER_OFFLINE=false

# Archive response cache lifetime, request timeout and the largest product file downloaded.
EXPLORER_CACHE_TTL_HOURS=24
EXPLORER_HTTP_TIMEOUT_S=30
EXPLORER_MAX_PRODUCT_MB=100

# Optional: your contact email, appended to the User-Agent so archive operators can reach you.
EXPLORER_CONTACT_EMAIL=

# Archive endpoints (change only if an archive moves its service).
EXPLORER_NASA_TAP_URL=https://exoplanetarchive.ipac.caltech.edu/TAP/sync
EXPLORER_MAST_INVOKE_URL=https://mast.stsci.edu/api/v0/invoke
EXPLORER_EXOMAST_URL=https://exo.mast.stsci.edu/api/v0.1

# Comma-separated browser origins allowed to call the API directly (the bundled frontend proxies /api, so
# this only matters if you call the API from another origin).
EXPLORER_CORS_ORIGINS=http://localhost:3000

# ------------------------------------------------------------------ frontend (frontend/.env.local)
# Product name shown in the navigation and page titles.
NEXT_PUBLIC_APP_NAME="Exoplanet Explorer"

# Where the Next.js server proxies /api requests (the FastAPI backend).
API_URL=http://localhost:8000
